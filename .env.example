# ─── App ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Must be at least 32 characters — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-random-secret-here-must-be-32-chars-minimum
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ──────────────────────────────────────
POSTGRES_USER=hangar
POSTGRES_PASSWORD=hangar
POSTGRES_DB=hangar
DATABASE_URL=postgresql+asyncpg://hangar:hangar@postgres:5432/hangar

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth — GitHub OAuth ───────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Auth — Google OAuth ───────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── AI Provider ───────────────────────────────────
# Options: openai, google, ollama
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
AI_VISION_MODEL=gpt-4o
AI_TEXT_MODEL=gpt-4o

# For Gemini:
# AI_PROVIDER=google
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-gemini-key
# AI_VISION_MODEL=gemini-1.5-pro
# AI_TEXT_MODEL=gemini-1.5-pro

# For Ollama (free, local):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=not-needed
# AI_VISION_MODEL=gemma3:latest
# AI_TEXT_MODEL=gemma3:latest

# ─── Weather ───────────────────────────────────────
# Open-Meteo is free, no key needed
WEATHER_LAT=43.7315
WEATHER_LON=-79.7624

# ─── Storage ───────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10